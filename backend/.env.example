# 복사해서 backend/.env로 사용한다.
DATABASE_URL=postgresql+psycopg://naralab_xepy@localhost:5432/naralab_xepy
# 테스트가 매번 테이블을 비우므로 반드시 개발 DB와 다른 DB를 지정한다.
TEST_DATABASE_URL=postgresql+psycopg://naralab_xepy@localhost:5432/harness_test
# JWT 서명 키. `openssl rand -hex 32`로 만든다.
JWT_SECRET_KEY=change-me
# 개발 DB에 create-admin으로 만든 관리자 계정. 개발 서버에서 로그인을 확인할 때 쓴다.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
